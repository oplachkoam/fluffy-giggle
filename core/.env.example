# App
APP_NAME=fluffy-giggle
APP_ENV=local

# Auth
AUTH_LOGIN=operator
AUTH_PASSWORD=change-me-please

# HTTP server
HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=8000
HTTP_SERVER_READ_TIMEOUT=15s
HTTP_SERVER_WRITE_TIMEOUT=60s
HTTP_SERVER_IDLE_TIMEOUT=60s

# Logger
LOGGER_LEVEL=debug
LOGGER_FORMAT=text

# SQLite
SQLITE_PATH=data/app.db

# LLM
LLM_LOCAL_BASE_URL=https://openrouter.ai/api/v1
LLM_LOCAL_API_KEY=your-key
LLM_LOCAL_MODEL=qwen/qwen-2.5-7b-instruct
LLM_LOCAL_TIMEOUT=60s
LLM_LOCAL_MAX_RETRIES=2
LLM_LOCAL_DISABLE_THINKING=true
LLM_LOCAL_TEMPERATURE=0.2

LLM_VISION_BASE_URL=https://openrouter.ai/api/v1
LLM_VISION_API_KEY=your-key
LLM_VISION_MODEL=qwen/qwen-2.5-vl-7b-instruct
LLM_VISION_TIMEOUT=90s
LLM_VISION_MAX_RETRIES=2
LLM_VISION_DISABLE_THINKING=true
LLM_VISION_TEMPERATURE=0.2

LLM_CLOUD_BASE_URL=https://openrouter.ai/api/v1
LLM_CLOUD_API_KEY=your-key
LLM_CLOUD_MODEL=openai/gpt-6
LLM_CLOUD_TIMEOUT=90s
LLM_CLOUD_MAX_RETRIES=2
LLM_CLOUD_DISABLE_THINKING=false

# Pipeline
PIPELINE_CONCURRENCY=4
PIPELINE_GATE2_MAX_PASSES=3
